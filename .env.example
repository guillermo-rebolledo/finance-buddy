# Set these locally in .env.local and separately in Vercel for each environment.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the iOS OAuth client whose Google ID tokens native sign-in accepts.
GOOGLE_IOS_CLIENT_ID=
# Optional Apple sign-in: set both; see docs/apple-sign-in.md for JWT generation.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional: the native iOS bundle ID whose Apple ID tokens are accepted.
APPLE_IOS_BUNDLE_ID=
# Separate bundle-ID JWT for native Apple account-deletion authorization codes.
APPLE_IOS_CLIENT_SECRET=
# Optional: the oldest iOS app build the server still serves, for example 12.
MINIMUM_IOS_BUILD=
